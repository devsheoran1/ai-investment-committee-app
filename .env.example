# Copy this file to ".env" (same folder) and fill in your key.
# Never share .env or commit it to GitHub — it contains your password-like API key.

# Which AI brain the agents use: groq | ollama | gemini | anthropic | mock
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys  (sign up, "Create API Key", paste below)
GROQ_API_KEY=

# Only needed if you switch provider
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# SEC EDGAR asks for a contact in the User-Agent (8-K news feed). Put a team contact here.
SEC_USER_AGENT=AIInvestmentCommittee your-team-contact@example.com
FINNHUB_API_KEY=
POLYGON_API_KEY=
